# Copy this file to local.properties and set real values for your environment.
# local.properties is gitignored — never commit it.
#
# Android SDK path (set automatically by Android Studio):
sdk.dir=/path/to/your/Android/Sdk

# Network endpoints for the SPAMS backend.
# Set the URLs that match your local / Tailscale / LAN setup.
BASE_URL=http://10.0.2.2/UASPMS/spams/
TAILSCALE_IP_BASE_URL=http://10.0.2.2/UASPMS/spams/
LAN_BASE_URL=http://10.0.2.2/UASPMS/spams/
LOCAL_BASE_URL=http://10.0.2.2/UASPMS/spams/
