Options -Indexes

# The project root contains source code, Git metadata, database dumps, scripts,
# and local artifacts. Only the SPAMS web application is intended to be public.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^spmu-andrew\.tail985047\.ts\.net(?::\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L,NE]
    RewriteRule ^(?:\.git|database|scripts|tools|docs|devtools|exports|logs|android|uploads|\.github|\.agents|\.codex)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^\.env(\..*)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(tmp_.*|cookies\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

ErrorDocument 404 /spams/errors/404.php
ErrorDocument 500 /spams/errors/500.php
