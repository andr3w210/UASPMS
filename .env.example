# Copy this file to `.env` and set real values for your environment.
# NEVER commit the real .env file — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=spamsdb
# Use a least-privilege database user in production. Do not use root/blank credentials.
DB_USER=uaspms_app
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# ── Trip / secondary database ─────────────────────────────────────────────────
# Defaults to the same host/user/pass as the primary DB if left blank.
TRIP_DB_HOST=127.0.0.1
TRIP_DB_NAME=uaspms_tripdb
TRIP_DB_USER=uaspms_trip_app
TRIP_DB_PASS=CHANGE_ME_STRONG_PASSWORD

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=University of Antique

# Full public URL of the deployment root (no trailing slash).
# Example: https://yourdomain.example.com  or  http://192.168.1.10
APP_URL=

# PHP web path prefix for the spams/ subdirectory (no trailing slash).
# This is the path portion of the URL after the hostname.
# Example: /UASPMS/spams  or  /spams  or  (empty string for root installs)
BASE_URL=/UASPMS/spams

TIMEZONE=Asia/Manila

# Debug upload/request logging toggle (set to 1 only for short-term diagnostics)
UPLOAD_DEBUG_LOG=0

# Optional absolute path to downloadable LAN CA cert used by System Access settings.
# Leave blank when not used.
UASPMS_CA_CERT_PATH=

# ── AI / OCR integrations ─────────────────────────────────────────────────────
# Leave blank to disable the feature. Never expose these values to the frontend.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
