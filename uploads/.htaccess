# Root uploads are data-only. Block script execution and sensitive text artifacts.

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>

<FilesMatch "(?i)\.(php|phtml|phar|php3|php4|php5|php7|php8|cgi|pl|py|sh|bat|cmd|exe|com|dll|log|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
